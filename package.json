{
  "name": "beautique",
  "version": "0.6.0",
  "private": true,
  "description": "BEAUtique: design BEAST X analyses for genomic epidemiology of virus genomes",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @beautique/app",
    "build": "npm run build -w @beautique/cli && npm run build -w @beautique/app",
    "build:cli": "npm run build -w @beautique/cli",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && npm run check -w @beautique/app",
    "beast": "node scripts/run-beast.mjs",
    "e2e": "playwright test",
    "check:beast": "npm run build:cli && node scripts/check-beast.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
